{
  "name": "m3n",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && vite",
    "build:packages": "npm run build -w @m3n/notation && npm run build -w @m3n/score-renderer",
    "build": "npm run build:packages && tsc -b && vite build",
    "lint": "oxlint",
    "test:packages": "npm run test -w @m3n/notation && npm run test -w @m3n/score-renderer",
    "test": "npm run build:packages && npm run test:packages && vitest run",
    "test:e2e": "playwright test",
    "typecheck:packages": "npm run typecheck -w @m3n/notation && npm run typecheck -w @m3n/score-renderer",
    "check": "npm run lint && npm run typecheck:packages && npm run test && npm run build && npm run test:e2e",
    "download:fluidr3": "node tools/download-fluidr3-gm.mjs",
    "preview": "vite preview",
    "preview:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "generate:icon": "node tools/generate-brand-icon.mjs",
    "format:scores": "npm run build -w @m3n/notation && tsx tools/format-scores.mts"
  },
  "dependencies": {
    "@m3n/notation": "*",
    "@m3n/score-renderer": "*",
    "jspdf": "^4.2.1",
    "pinyin-pro": "^3.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "spessasynth_lib": "^4.3.12",
    "txml": "^6.0.0",
    "verovio": "^6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
