{
  "name": "m3n",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && vite",
    "build:packages": "npm run build -w @m3n/jpfun && npm run build -w @m3n/notation && npm run build -w @m3n/numbered-notation && npm run build -w @m3n/score-renderer",
    "build": "npm run build:packages && tsc -b && vite build",
    "lint": "oxlint",
    "test:packages": "npm run test -w @m3n/jpfun && npm run test -w @m3n/notation && npm run test -w @m3n/numbered-notation && npm run test -w @m3n/score-renderer",
    "test": "npm run build:packages && npm run test:packages && npm run test:scorebook && vitest run",
    "test:scorebook": "node --test tools/scorebook-pagination.test.mjs",
    "test:e2e": "playwright test",
    "typecheck:packages": "npm run typecheck -w @m3n/jpfun && npm run typecheck -w @m3n/notation && npm run typecheck -w @m3n/numbered-notation && npm run typecheck -w @m3n/score-renderer",
    "check": "npm run check:boundaries && npm run lint && npm run typecheck:packages && npm run test && npm run build && npm run test:numbered-layout && npm run test:e2e",
    "download:fluidr3": "node tools/download-fluidr3-gm.mjs",
    "build:verovio": "node tools/build-verovio.mjs",
    "test:verovio": "npm run build -w @m3n/notation && node tools/verify-verovio.mjs",
    "preview": "vite preview",
    "preview:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "generate:icon": "node tools/generate-brand-icon.mjs",
    "format:scores": "npm run build -w @m3n/notation && tsx tools/format-scores.mts",
    "test:numbered-layout": "node tools/verify-numbered-layout.mjs",
    "test:numbered-audit": "node tools/verify-numbered-layout.mjs --screenshots",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "build:scorebook": "npm run build:packages && node tools/build-scorebook.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@m3n/notation": "*",
    "@m3n/numbered-notation": "*",
    "@m3n/score-renderer": "*",
    "jspdf": "^4.2.1",
    "opentype.js": "^2.0.0",
    "pinyin-pro": "^3.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "spessasynth_lib": "^4.3.12",
    "svg2pdf.js": "^2.8.1",
    "txml": "^6.0.0",
    "verovio": "6.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
