{
  "name": "m3n",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && vite",
    "build:packages": "node tools/build-packages.mjs",
    "build": "npm run build:packages && tsc -b && node tools/build-web.mjs",
    "lint": "oxlint",
    "test:packages": "vitest run packages/",
    "test:hosting": "node --import tsx --test tools/hosting-build.test.mjs",
    "test": "node tools/verify-project.mjs offline",
    "test:scorebook": "node --test --test-concurrency=1 tools/scorebook-width.test.mjs tools/compare-width-selection.test.mjs tools/ink-overlap-pairs.test.mjs tools/scorebook-measurement.test.mjs tools/scorebook-front-font.test.mjs",
    "test:scorebook:browser": "node tools/verify-project.mjs browser",
    "test:e2e": "python3 tools/run-low-memory.py node tools/verify-project.mjs e2e",
    "typecheck:packages": "npm run typecheck -w @m3n/notation && npm run typecheck -w @m3n/numbered-notation && npm run typecheck -w @m3n/score-renderer",
    "check": "python3 tools/run-low-memory.py node tools/verify-project.mjs",
    "download:fluidr3": "node tools/download-fluidr3-gm.mjs",
    "preview": "vite preview",
    "preview:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "generate:icon": "node tools/generate-brand-icon.mjs",
    "format:scores": "npm run build -w @m3n/notation && tsx tools/format-scores.mts",
    "test:numbered-layout": "npm run test:native-ink",
    "test:notation-density": "npm run build:packages && node tools/compare-notation-density.mjs --regression",
    "test:staff-layout": "npm run test:notation-density",
    "test:native-ink": "npm run check:ci",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "refresh:staff-widths": "npm run build:packages && node tools/refresh-staff-widths.mjs",
    "build:scorebook": "npm run build:packages && node tools/build-scorebook.mjs",
    "export:score-pdfs": "npm run build:packages && node tools/export-score-pdfs.mjs",
    "compact:scorebook": "node tools/compact-scorebook-pdf.mjs",
    "test:pdf-font": "node --test tools/builtin-pdf-font.test.mjs",
    "test:pdf-font:full": "npm run test:pdf-font",
    "prepare": "node tools/install-git-hooks.mjs",
    "prepare:scores": "node tools/score-artifacts.mjs",
    "prepare:library-fonts": "node tools/prepare-library-fonts.mjs",
    "check:score-artifacts": "node tools/score-artifacts.mjs --check",
    "test:staff-spacing-regression": "npm run build:packages && node tools/benchmark-numbered-spacing.mjs --staff --check --prune",
    "test:spacing-regression": "npm run build:packages && node tools/benchmark-numbered-spacing.mjs --check --numeric-layout --prune",
    "test:tools": "node tools/verify-project.mjs tools",
    "check:ci": "python3 tools/run-low-memory.py node tools/verify-project.mjs ci",
    "check:non-e2e": "python3 tools/run-low-memory.py node tools/verify-project.mjs non-e2e"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@m3n/notation": "*",
    "@m3n/numbered-notation": "*",
    "@m3n/score-renderer": "*",
    "pinyin-pro": "^3.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "spessasynth_lib": "^4.3.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.71.0",
    "pdf-lib": "^1.17.1",
    "spessasynth_core": "^4.3.12",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
