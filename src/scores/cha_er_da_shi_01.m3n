{title=查尔达什舞曲}
{subtitle=Csárdás}
{composer=Vittorio Monti}
// 依据IMSLP #97352；不录钢琴伴奏、弓法、指法及小字号倚音。
// 泛音段以单音及显式8va记实音，书写降低八度；速度数值为播放设置。
// Largo
{key=Dm} {4/4} {60qpm}
N: {text=Largo}0^ (0 3d) (4d 3d) |
---
N: 3^~ (3 1) (1 2) |
---
N: (1 7d) 4^~ (4 4d) |
---
N: (4d 3d) (5#d 7d) (2 2) (1 5d) |
---
N: (7d 6d) ((6d 5#d 6d 7d)) (1 3d) (4d 3d) |
---
N: 3^~ (3 1) (1 2) |
---
N: (1 7d) 4^~ (4 4d) |
---
N: (4d 3d) (6d 5#d) 2. (7d) |
---
N: (7d 6d) (6d 5#d) 6d 0 |
---
// Largo · 华彩乐句
N: {key=Dm} {4/4} {60qpm} ||: 5d~ (([5d 7d 2:2])) (([4 5 7:2])) ((2e. (1e) 7. (6))) (5 4) |
---
N: (4 3) (3. (3b)) 3=^ |
---
N: 3d~ (([3d 5#d 7d:2])) (([2 3 5#:2])) (7 5) (3e 3) |
---
N: (7 6) ((6 5# 6 7)) 1e 1e |
---
N: 1e 4~{fermata} (((4 7 1e 7 6# 7 1e 7))) ([2e 1e 7:2]) |
---
N: (7 3) 3~ (3 (3b 3=)) ((4 3 5.{fermata} (4))) |
---
N: ((4 3 3 2)) ((2 1 1 7d)) 3. (7d) |
---
N: (7d 6d) (6d 5#d) 6d 0 :||
---
// Allegro vivo
N: {key=Dm} {2/4} {144qpm} ||: {text=Allegro vivo}(6 6e) (0 4e) |
---
N: (0 3e) (0 1e) |
---
N: (7) 6 (5#) |
---
N: 6~ (6 0) |
---
N: ((6 7 1e 7)) ((6 7 1e 7)) |
---
N: ((6 7 1e 7)) ((6 7 1e 6)) |
---
N: (1e) 7 (6#) |
---
N: 7~ (7 0) |
---
N: ((2e 3e 4e 3e)) ((2e 3e 4e 3e)) |
---
N: ((2e 3e 4e 3e)) ((2e 4e 3e 2e)) |
---
N: ((1e 2e 3e 2e)) ((1e 2e 3e 2e)) |
---
N: ((1e 2e 3e 2e)) ((1e 3e 2e 1e)) |
---
N: ((3 4# 5# 6)) ((7 1e 2e 3e)) |
---
N: ((4e 3e 2e 1e)) ((7 6 5# 7)) |
---
N: (7) 6 (5#) |
---
N: 6 0 :||
---
// Allegro vivo · 第二主题
N: {key=Dm} {2/4} {144qpm} ||: ((5 4# 5 7)) ((2e 4e 2e 7)) |
---
N: ((5 4# 5 7)) ((2e 4e 2e 7)) |
---
N: ((4 3 4 5)) ((6 7 1e 2e)) |
---
N: 3e~ (3e 0) |
---
N: ((3 2# 3 5#)) ((7 2e 7 5)) |
---
N: ((3 2# 3 5#)) ((7 2e 7 5)) |
---
N: ((3 2# 3 4#)) ((5# 6 7 6)) |
---
N: 1e~ (1e 0) |
---
N: ((4e 3e 2e 3e)) ((4e 3e 2e 3e)) |
---
N: ((4e 3e 2e 3e)) ((4e 3e 2e 4e)) |
---
N: ((3e 2e 1e 2e)) ((3e 2e 1e 2e)) |
---
N: ((3e 2e 1e 2e)) ((3e 2e 1e 3e)) |
---
N: ((3 4# 5# 6)) ((7 1e 2e 3e)) |
---
N: ((4e 3e 2e 1e)) ((7 6 5# 7)) |
---
N: (7) 6 (5#) |
---
N: 6 0 :||
---
// Molto meno
N: {key=D} {2/4} {72qpm} {text=Molto meno}1ee (5e. (5e)) |
---
N: (6e 5e) (4e 3e) |
---
N: (3e 2e) ((2e 1#e 2e 4e)) |
---
N: 6e^ |
---
N: (6e. (7)) (7 2ee) |
---
N: (2ee. (4e)) (4e 4e) |
---
N: (4e 3e) ((3e 2e 1e 2e)) |
---
N: 3e^ |
---
N: 1ee (5e. (5e)) |
---
N: (6e 5e) (4e 3e) |
---
N: (3e 2e) ((2e 1#e 2e 4e)) |
---
N: 6e^ |
---
N: (1ee. (5e)) (5e 5e) |
---
N: (6e 5e) (5e 7) |
---
N: (2e 1e) (1e 7) |
---
N: 1e 0 |
---
// Meno, quasi lento · 泛音旋律（实音）
N: {key=D} {2/4} {66qpm} {text=Meno, quasi lento}{8va}1ee (5e. (5e)) |
---
N: (6e 5e) (4e 3e) |
---
N: (3e 2e) (2e 4e) |
---
N: 6e^ |
---
N: (6e. (5e)) (5e 5e) |
---
N: (7e 6e) (5e 4e) |
---
N: (4e 3e) (3e 3be) |
---
N: 3e^ |
---
N: 1ee (5e. (5e)) |
---
N: (6e 5e) (4e 3e) |
---
N: (3e 2e) (2e 4e) |
---
N: 6e^ |
---
N: 1ee (5e. (5e)) |
---
N: (6e 5e) (5e 7) |
---
N: (2e 1e) (1e 7) |
---
N: 1e^{fermata}{/} |
---
// Allegro vivace
N: {key=Dm} {2/4} {152qpm} {text=Allegro vivace}((5 4# 5 7)) ((2e 4e 2e 7)) |
---
N: ((5 4# 5 7)) ((2e 4e 2e 7)) |
---
N: ((4 3 4 5)) ((6 7 1e 2e)) |
---
N: 3e~ (3e 0) |
---
N: ((3 2# 3 5#)) ((7 2e 7 5)) |
---
N: ((3 2# 3 5#)) ((7 2e 7 5)) |
---
N: ((3 2# 3 4#)) ((5# 6 7 6)) |
---
N: 1e~ (1e 0) |
---
N: ((4e 3e 2e 3e)) ((4e 3e 2e 3e)) |
---
N: ((4e 3e 2e 3e)) ((4e 3e 2e 4e)) |
---
N: ((3e 2e 1e 2e)) ((3e 2e 1e 2e)) |
---
N: ((3e 2e 1e 2e)) ((3e 2e 1e 3e)) |
---
N: ((3 4# 5# 6)) ((7 1e 2e 3e)) |
---
N: ((4e 3e 2#e 3e)) ((2=e 3e 4#e 5#e)) |
---
// Allegretto
