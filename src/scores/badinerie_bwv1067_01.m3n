{title=谐谑曲}
{subtitle=BWV 1067}
{composer=巴赫} {arranger=Vojtěch Pospíchal}
{key=Bm} {2/4} {120qpm}
// 按Flutetunes独奏谱校对完整主旋律，跨音区取主奏线；不录入伴奏和钢琴指法。
N: ||: (6e{tip} (1ee 6e)) |
---
N: (3e{tip} (6e 3e)) (1e{tip} (3e 1e)) |
---
N: 6 ((3 6 1e 6)) |
---
N: ((7 6 7 6)) ((5# 7 2e 7)) |
---
N: {lg}(1e 6){/} (6e{tip} (1ee 6e)) |
---
N: (3e{tip} (6e 3e)) (1e{tip} (3e 1e)) |
---
N: 6 (1e{tip} 1e{tip}) |
---
N: (1e{tip} 1e{tip}) (6e{tip} 1e{tip}) |
---
N: (1e{tr} 7) (3e{tip} 3e{tip}) |
---
N: (3e{tip} 3e{tip}) (1ee{tip} 3e{tip}) |
---
N: (3e{tr} 2#e) ((7 3e 5e 3e)) |
---
N: ((4#e 3e 4e 3e)) ((2#e 4e 6e 4e)) |
---
N: ((5e 4#e 5e 4#e)) ((3e 5e {lg}3e 2#e)) |
---
N: ((3e{/} 6e {lg}3e 2#e)) ((3e{/} 7e {lg}3e 2e)) |
---
N: ((3e{/} 1ee {lg}3e 2#e)) ((3e{/} 1ee {lg}7e 6e)) |
---
N: ((7e{/} 5e 4#e 3e)) (5e 4#e{tr}) |
---
N: 3e :||
---
N: {br} ||: (3e{tip} (5e 3e)) |
---
N: (7{tip} (3e 7)) (5{tip} (7 5)) |
---
N: 3 {lg}(7b 6){/} |
---
N: {lg}(2e (1#e{/} 3e)) (5e (4e 3e)) |
---
N: (4e 2e) (4e{tip} (6e 4e)) |
---
N: (2e{tip} (4e 2e)) (7{tip} (2e 7)) |
---
N: 5~ ((5 1e 3e 1e)) |
---
N: ((2e 1e 2e 1e)) ((7 2e 4e 2e)) |
---
N: ((3e 2e 3e 2e)) ((1e 3e {lg}1e 7)) |
---
N: ((1e{/} 4e {lg}1e 7)) ((1e{/} 5e {lg}1e 7)) |
---
N: ((1e{/} 6e {lg}1e 7)) ((1e{/} 6e 5e 4e)) |
---
N: ((5e 3e 2e 1e)) (3e 2e{tr}) |
---
N: 1e (3e{tip} 3e{tip}) |
---
N: (3e{tip} 3e{tip}) (1ee{tip} 3e{tip}) |
---
N: (3e{tr} 2e{tip}) (2e{tip} 2e{tip}) |
---
N: (2e{tip} 2e{tip}) (7e{tip} 2e{tip}) |
---
N: (2e{tr} 1e) (6e{tip} (1ee 6e)) |
---
N: (5e) (4e.~ (4e {lg}(6e 5e 4e 3e){/})) |
---
N: 2e~ (2e {lg}((4e 3e 2e 1e)){/}) |
---
N: ((7b 2e 4e 2e)) ({lg}(7 6){/} {lg}(7 6){/}) |
---
N: (5#{tip} 3{tip}) {lg}(4 3){/} |
---
N: {lg}(6 (5#{/} 7)) (2e (1e 7)) |
---
N: (1e (({lg}6 7 1e 2e))) (3e{/} (1e 3e)) |
---
N: (6e{tip} 3e{tip}) ((2e 1e 7 1e)) |
---
N: 6{ap(7)}{fermata} :|||
