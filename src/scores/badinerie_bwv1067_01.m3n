---
N: ((3e{/} 1ee {lg}3e 2#e)) ((3e{/} 1ee {lg}7e 6e)) |
---
N: ((7e{/} 5e 4#e 3e)) (5e {lg}(4e (5e 4e))) |
---
N: 3e{/} :||
---
N: ||: (3e{tip} (5e 3e)) |
---
N: (7 (3e 7)) (5 (7 5)) |
---
N: 3 (7b 6) |
---
N: (2e (1#e 3e)) (5e (4e 3e)) |
---
N: (4e 2e) (4e (6e 4e)) |
---
N: (2e (4e 2e)) (7 (2e 7)) |
---
N: 5~ ((5 1e 3e 1e)) |
---
N: ((2e 1e 2e 1e)) ((7 2e 4e 2e)) |
---
N: ((3e 2e (3e 1e 2e 7))) ((1e 3e {lg}1e 7)) |
---
N: ((1e{/} 4e {lg}1e 7)) ((1e{/} 5e {lg}1e 7)) |
---
N: ((1e{/} 6e {lg}1e 7)) ((1e{/} 6e 5e 4e)) |
---
N: ((5e 3e 2e 1e)) ((3e 2e 3e 2e)) |
---
N: 1e (3e (2e {lg}3e~)) |
---
N: ((3e{/} 2e) {lg}3e) ((3e{/} 1ee) 3e) |
---
N: ((3e {lg}(4e 3e) 2e)) ((2e{/})) (1e 2e) |
---
N: ((2e 1e) {lg}2e) ((2e{/} 7) 2e) |
---
N: ((2e {lg}(3e 2e) 1e)) ((6{/})) (1e 6) |
---
N: (5e) (4e.~ (4e)) {lg}(((6e 5e 4e 3e))){/} |
---
N: {lg}2e~ (2e{/} ((4e 3e 2e 1e))) |
---
N: ((7b 2e 4e 2e)) ({lg}(7 6){/} {lg}(7 6){/}) |
---
N: (5# 3) {lg}(4 3){/} |
---
N: {lg}(6 (5#{/} 7)) (2e (1e 7)) |
---
