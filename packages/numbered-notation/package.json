{
  "name": "@m3n/numbered-notation",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layout-config": {
      "types": "./dist/score-layout-config.d.ts",
      "import": "./dist/score-layout-config.js"
    },
    "./layout-quality": {
      "types": "./dist/layout/quality.d.ts",
      "import": "./dist/layout/quality.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('src/font-assets', 'dist/font-assets', { recursive: true });\"",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@m3n/notation": "*",
    "@pdf-lib/fontkit": "^1.1.1",
    "txml": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
