{
  "name": "@m3n/score-renderer",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "vendor"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js"
    },
    "./player": {
      "types": "./dist/spessa-player.d.ts",
      "import": "./dist/spessa-player.js"
    },
    "./tones": {
      "types": "./dist/playback-tones.d.ts",
      "import": "./dist/playback-tones.js"
    },
    "./playback": {
      "types": "./dist/native-playback-score.d.ts",
      "import": "./dist/native-playback-score.js"
    },
    "./staff": {
      "types": "./dist/staff/staff-score.d.ts",
      "import": "./dist/staff/staff-score.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@m3n/notation": "*",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "spessasynth_core": "^4.3.12",
    "spessasynth_lib": "^4.3.12",
    "svg-path-bbox": "^2.1.0",
    "txml": "^6.0.3",
    "verovio": "6.2.0",
    "@m3n/numbered-notation": "*"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
