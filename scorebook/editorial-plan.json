  "sections": [
    {
      "id": "basics",
      "title": "第一篇　基础练习与入门短曲",
      "description": "先稳定长音与力度，再练四分、八分音符、附点与简单连奏。"
    },
    {
      "id": "folk",
      "title": "第二篇　民歌与经典旋律",
      "description": "从熟悉的歌唱性旋律过渡到小调、三拍子、多段歌词与变拍。"
    },
    {
      "id": "pop",
      "title": "第三篇　流行歌曲",
      "description": "先练较规整的慢歌，再处理切分、十六分音符、三连音、变调和复杂反复。"
    },
    {
      "id": "instrumental",
      "title": "第四篇　影视与经典器乐",
      "description": "从短主题旋律开始，逐步加入装饰、快速音型、半音和多次变调。"
    },
    {
      "id": "technique",
      "title": "附篇　半音阶口琴专项进阶",
      "description": "延续开篇长音练习；按音阶、模进、连音组、跳进和机能技巧逐步训练。"
    }
  ],
