{
  "title": "Max的半音阶口琴乐谱集",
  "sourceCount": 88,
  "sections": [
    {
      "id": "basics",
      "title": "第一章　基础练习",
      "description": "常规基本功贯穿全程；旋律由稳定拍点、基本时值与连奏，逐步进入弱起、附点、切分及十六分音符。",
      "reorderForSharing": false
    },
    {
      "id": "advanced",
      "title": "第二章　进阶练习",
      "description": "由节奏综合、临时变音与音区转换，进入快速音型和转调；章末为综合挑战。",
      "reorderForSharing": false
    },
    {
      "id": "classic",
      "title": "第三章　经典旋律",
      "description": "传统经典与较早的流行、影视歌曲；由规整短句进入复拍、密集节奏与变拍。",
      "reorderForSharing": true
    },
    {
      "id": "golden",
      "title": "第四章　流行金曲",
      "description": "成熟流行作品与影视金曲；由三拍、复拍和抒情长句，进入切分、三连音与完整长篇演奏。",
      "reorderForSharing": true
    },
    {
      "id": "pop",
      "title": "第五章　现代流行",
      "description": "较新的流行作品与部分延续曲目；由长音、连奏与切分，进入密集节奏、变调和快速动漫主题。",
      "reorderForSharing": true
    },
    {
      "id": "instrumental",
      "title": "第六章　古典与器乐",
      "description": "由歌唱性旋律和舞曲，进入持续快速音型、装饰、半音及长篇结构的综合挑战。",
      "reorderForSharing": true
    }
  ],
